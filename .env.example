# Copy this file to .env and fill in real values. Never commit .env.

# From https://ollama.com/settings/keys. Only needed to chat with the AI, not to log in.
OLLAMA_API_KEY=
# Optional. Model used when a chat request names none (see GET /chat/ai/models).
OLLAMA_DEFAULT_MODEL=gemma4:31b

# From https://console.groq.com/keys. Only needed to chat with Groq models.
GROQ_API_KEY=
# Optional. Model used when a Groq request names none.
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Optional: "groq" or "ollama". Defaults to groq when GROQ_API_KEY is set, else ollama.
DEFAULT_AI_PROVIDER=

# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./test.db
