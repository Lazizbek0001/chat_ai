# Copy this file to .env and fill in real values. Never commit .env.

# From https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Model the agents use. It must support tool calling.
AGENT_MODEL=gpt-oss:120b-cloud

# Lets the ops agent run shell commands on this machine. Every command waits for your
# approval (POST /tasks/{id}/approve). Leave false unless you need it.
ENABLE_SHELL_TOOL=false
